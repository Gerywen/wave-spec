{
  "name": "audio-player-control",
  "version": "0.1.0",
  "description": "Multi-lane waveform/spectrogram audio player control",
  "type": "module",
  "main": "./dist/audio-player-control.js",
  "module": "./dist/audio-player-control.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/audio-player-control.js"
    },
    "./style.css": "./dist/audio-player-control.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "site:build:pages": "SITE_BASE=/wave-spec/ vite build --config site/vite.config.ts && cp dist-site/index.html dist-site/404.html",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && vite build --config vite.lib.config.ts",
    "preview": "vite preview"
  },
  "keywords": [
    "audio",
    "waveform",
    "spectrogram",
    "player"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.2.4",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  }
}
